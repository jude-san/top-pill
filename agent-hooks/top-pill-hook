#!/usr/bin/env python3
"""Top Pill hook for Claude Code and Codex.

Usage (set up by agent-hooks.sh):  top-pill-hook claude|codex   (hook JSON on stdin)

PermissionRequest: asks the Top Pill over D-Bus and waits for Allow/Deny.
If there is no answer (pill not running, timed out, answered in the terminal),
it prints nothing, so the agent asks in its terminal as usual.
Notification / Stop: tells the pill, without waiting.
"""
import json
import subprocess
import sys

DEST = "org.gnome.Shell"
PATH = "/org/gnome/Shell/Extensions/TopPill"
IFACE = "org.gnome.Shell.Extensions.TopPill"


def gvariant_string(text):
    """A string in GVariant text form, as gdbus expects its arguments."""
    escaped = text.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    return f"'{escaped}'"


def call(method, arg, timeout):
    arg = gvariant_string(arg)
    try:
        out = subprocess.run(
            ["gdbus", "call", "--session", "--timeout", str(timeout), "--dest", DEST,
             "--object-path", PATH, "--method", f"{IFACE}.{method}", arg],
            capture_output=True, text=True, timeout=timeout + 5)
    except Exception:
        return ""
    if out.returncode != 0:
        return ""
    text = out.stdout.strip()            # e.g. ('allow',)
    if text.startswith("('") and "'" in text[2:]:
        return text[2:text.index("'", 2)]
    return ""


def summary(tool_input):
    if not isinstance(tool_input, dict):
        return str(tool_input)
    for key in ("command", "file_path", "path", "url", "pattern", "query"):
        if isinstance(tool_input.get(key), str):
            return tool_input[key]
    return ", ".join(f"{k}: {v}" for k, v in tool_input.items())


def main():
    ai = sys.argv[1] if len(sys.argv) > 1 else "claude"
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return
    event = payload.get("hook_event_name", "")
    if event == "PermissionRequest":
        suggestions = [s for s in payload.get("permission_suggestions") or []
                       if isinstance(s, dict) and s.get("type") in ("addRules", "addDirectories")]
        text = summary(payload.get("tool_input"))
        # Long or multi-line requests are left to the terminal, where they show in full.
        if len(text) > 400 or text.count("\n") > 4:
            return
        request = {
            "ai": ai, "tool": payload.get("tool_name", ""), "input": text,
            "cwd": payload.get("cwd", ""), "always": ai == "claude" and bool(suggestions),
        }
        answer = call("Ask", json.dumps(request), 570)
        if answer == "allow":
            decision = {"behavior": "allow"}
        elif answer == "always":
            decision = {"behavior": "allow"}
            if ai == "claude" and suggestions:
                decision["updatedPermissions"] = suggestions
        elif answer == "deny":
            decision = {"behavior": "deny", "message": "Denied from Top Pill."}
        else:
            return
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": decision}}))
    elif event in ("Notification", "Stop"):
        ev = {"ai": ai, "kind": "notification" if event == "Notification" else "stop",
              "cwd": payload.get("cwd", ""), "message": payload.get("message", "")}
        call("Event", json.dumps(ev), 2)


if __name__ == "__main__":
    main()
